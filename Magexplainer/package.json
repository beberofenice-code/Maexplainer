{
  "name": "magexplainer",
  "version": "1.0.0",
  "description": "GeoGlobe Tales-style vertical map explainer video engine built with Remotion and MapLibre GL JS.",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts SpainsStrangestBorders out/spains-strangest-borders.mp4 --codec=h264 --pixel-format=yuv420p",
    "render:still": "remotion still src/index.ts SpainsStrangestBorders out/preview.png --frame=60",
    "render:italy": "remotion render src/index.ts ItalysStrangestBorders out/italys-strangest-borders.mp4 --codec=h264 --pixel-format=yuv420p",
    "render:france": "remotion render src/index.ts FrancesStrangestBorders out/frances-strangest-borders.mp4 --codec=h264 --pixel-format=yuv420p",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.240",
    "@remotion/media-utils": "^4.0.240",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.240"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
