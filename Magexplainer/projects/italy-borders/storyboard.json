  "captions": [
    {
      "startFrame": 0,
      "endFrame": 30,
      "text": "Did you know"
    },
    {
      "startFrame": 30,
      "endFrame": 66,
      "text": "Italy hides"
    },
    {
      "startFrame": 66,
      "endFrame": 102,
      "text": "two countries inside it?"
    },
    {
      "startFrame": 102,
      "endFrame": 144,
      "text": "On the map, its borders look simple:"
    },
    {
      "startFrame": 144,
      "endFrame": 186,
      "text": "France, Switzerland,"
    },
    {
      "startFrame": 186,
      "endFrame": 228,
      "text": "Austria and Slovenia."
    },
    {
      "startFrame": 228,
      "endFrame": 288,
      "text": "But there are two more neighbors"
    },
    {
      "startFrame": 288,
      "endFrame": 345,
      "text": "hiding completely inside Italy."
    },
    {
      "startFrame": 345,
      "endFrame": 405,
      "text": "The first is in the heart of Rome:"
    },
    {
      "startFrame": 405,
      "endFrame": 465,
      "text": "Vatican City,"
    },
    {
      "startFrame": 465,
      "endFrame": 540,
      "text": "the smallest country in the world."
    },
    {
      "startFrame": 540,
      "endFrame": 615,
      "text": "It covers just 0.44 square kilometers"
    },
    {
      "startFrame": 615,
      "endFrame": 690,
      "text": "and has fewer than 1,000 residents."
    },
    {
      "startFrame": 690,
      "endFrame": 765,
      "text": "The second lies further north:"
    },
    {
      "startFrame": 765,
      "endFrame": 840,
      "text": "the Republic of San Marino,"
    },
    {
      "startFrame": 840,
      "endFrame": 930,
      "text": "a mountaintop state completely surrounded by Italy."
    },
    {
      "startFrame": 930,
      "endFrame": 1020,
      "text": "Home to about 34,000 people,"
    },
    {
      "startFrame": 1020,
      "endFrame": 1110,
      "text": "it covers just 61 square kilometers"
    },
    {
      "startFrame": 1110,
      "endFrame": 1200,
      "text": "and traces its founding back to 301 AD."
    },
    {
      "startFrame": 1200,
      "endFrame": 1275,
      "text": "Italy also plays the trick in reverse."
    },
    {
      "startFrame": 1275,
      "endFrame": 1335,
      "text": "On the shore of Lake Lugano"
    },
    {
      "startFrame": 1335,
      "endFrame": 1410,
      "text": "lies Campione d'Italia —"
    },
    {
      "startFrame": 1410,
      "endFrame": 1500,
      "text": "an Italian town completely surrounded by Switzerland,"
    },
    {
      "startFrame": 1500,
      "endFrame": 1590,
      "text": "less than a kilometer from the rest of Italy."
    },
    {
      "startFrame": 1590,
      "endFrame": 1665,
      "text": "For decades it used Swiss francs"
    },
    {
      "startFrame": 1665,
      "endFrame": 1740,
      "text": "and even Swiss license plates."
    },
    {
      "startFrame": 1740,
      "endFrame": 1830,
      "text": "But Italy's strangest border is in the Alps."
    },
    {
      "startFrame": 1830,
      "endFrame": 1920,
      "text": "Near the Matterhorn,"
    },
    {
      "startFrame": 1920,
      "endFrame": 2010,
      "text": "the border follows the glacier's watershed."
    },
    {
      "startFrame": 2010,
      "endFrame": 2100,
      "text": "As the glaciers melt, the watershed moves —"
    },
    {
      "startFrame": 2100,
      "endFrame": 2190,
      "text": "and so does the border."
    },
    {
      "startFrame": 2190,
      "endFrame": 2265,
      "text": "Here it shifted about 100 meters,"
    },
    {
      "startFrame": 2265,
      "endFrame": 2340,
      "text": "putting most of this Italian mountain hut in Switzerland."
    }
  ],
